{
  "name": "ticket-ink-saver",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browser-based utility to mask ads on PDF tickets before printing, to save ink.",
  "scripts": {
    "predev": "node scripts/generate-third-party-licenses.mjs",
    "dev": "vite",
    "prebuild": "node scripts/generate-third-party-licenses.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "licenses": "node scripts/generate-third-party-licenses.mjs"
  },
  "dependencies": {
    "@patternfly/react-core": "6.6.1",
    "@patternfly/react-icons": "6.6.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.3.289",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.6.0",
    "vite": "^8.3.0"
  },
  "license": "GPL-3.0-or-later",
  "author": "Ladislav Slezák"
}
